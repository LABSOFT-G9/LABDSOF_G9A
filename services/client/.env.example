# Copy to .env.local to change the defaults. Nothing here is a secret: VITE_* values are compiled into the bundle.

# Which adapters the composition root wires: "mock" (in-memory, no backend) or "http" (the real API behind /api).
VITE_ADAPTERS=mock
# Artificial latency of the mock adapters, in milliseconds.
VITE_MOCK_LATENCY_MS=300
# Edge OIDC plugin paths (ADR-005). LoginUri has no default in the plugin; these are placeholders until spike item 3.
VITE_LOGIN_URI=/oidc/login
VITE_LOGOUT_URI=/logout

# Dev server only (not compiled into the bundle): where `npm run dev` proxies /api, /oidc and /logout.
# The local stack's Traefik listens on port 80.
API_PROXY_TARGET=http://localhost:80
