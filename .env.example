# Local stack only: copy to .env (ignored by Git) and change every password.
#   docker compose -f compose.yaml -f compose.local.yaml up --build
# On the dev and prod hosts these values are written by the deploy
# (labdsof-infra, ansible/roles/app) from Parameter Store, not from this file.

# Image tag. `local` = images built from this checkout.
BMC_TAG=local

# Database. The local stack runs MySQL in the container `mysql`.
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root
ISSUE_DB_PASSWORD=change-me-issue
DISPATCH_DB_PASSWORD=change-me-dispatch
NOTIFICATION_DB_PASSWORD=change-me-notification
KEYCLOAK_DB_PASSWORD=change-me-keycloak
