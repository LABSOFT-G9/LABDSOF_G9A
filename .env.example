# Local stack only: copy to .env (ignored by Git) and change every password.
#   docker compose -f compose.yaml -f compose.local.yaml up --build
# On the dev and prod hosts these values are written by the deploy
# (labdsof-infra, ansible/roles/app) from Parameter Store, not from this file.

# Image tag. `local` = images built from this checkout.
BMC_TAG=local

# Database. The local stack runs MySQL in the container `mysql`.
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root
ISSUE_DB_PASSWORD=change-me-issue
DISPATCH_DB_PASSWORD=change-me-dispatch
NOTIFICATION_DB_PASSWORD=change-me-notification
KEYCLOAK_DB_PASSWORD=change-me-keycloak

# Identity (ADR-005, EN-02-04). Keycloak's bootstrap administrator (user
# `bmc-admin`, first start only), the secret of the Keycloak client `bmc-edge`
# used by Traefik's OIDC plugin, and the plugin's session-cookie secret, which
# must be exactly 32 characters (for example `openssl rand -hex 16`).
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
BMC_EDGE_CLIENT_SECRET=change-me-edge-client-secret
OIDC_PLUGIN_SECRET=change-me-32-characters-exactly0

# Password of every synthetic account (synthetic.resident.a1@bmc.example and
# the others in infra/keycloak/realm/bmc-users-0.json). 12 characters or more.
# The realm and its accounts are imported only into an empty Keycloak database:
# after changing these values, start again with `down -v`.
BMC_SYNTHETIC_USER_PASSWORD=change-me-synthetic

# Audience the services require in access tokens; the realm's `bmc-edge`
# client adds it. Issuer and signing keys are set in the Compose files.
OIDC_AUDIENCE=bmc-api

# Public name, for the TLS certificate in compose.yaml. The local stack
# (compose.local.yaml) serves plain HTTP and only needs a value here; on the
# hosts bmc-app-deploy sets it (dev: bmc-g9.duckdns.org).
BMC_PUBLIC_HOST=localhost

# Only if port 80 is taken on your machine: publish another port and tell
# Keycloak the address the browser uses. Both must change together.
#BMC_LOCAL_PORT=8880
#BMC_LOCAL_URL=http://localhost:8880
